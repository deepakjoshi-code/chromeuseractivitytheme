{
  "name": "aura-context-theme",
  "version": "1.0.0",
  "description": "Aura \u2014 a Chrome extension that adapts your browsing surfaces to what you are actually doing, entirely on-device.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node --test \"test/integration/*.test.js\"",
    "test:watch": "node --test --watch \"test/**/*.test.js\"",
    "test:visual": "node test/visual/render.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
