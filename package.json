{
  "name": "aura-context-theme",
  "version": "0.9.5",
  "description": "Aura \u2014 a Chrome extension that adapts your browsing surfaces to what you are actually doing, entirely on-device.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node --test \"test/integration/*.test.js\"",
    "test:watch": "node --test --watch \"test/**/*.test.js\"",
    "test:visual": "node test/visual/render.mjs",
    "test:e2e": "node --test --test-timeout=180000 \"test/e2e/*.test.mjs\"",
    "test:all": "npm test && npm run test:e2e",
    "build": "node tools/build.mjs",
    "store:assets": "node tools/store-assets.mjs",
    "verify": "node tools/build.mjs && node tools/verify-package.mjs",
    "proof": "node tools/overlay-proof.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
